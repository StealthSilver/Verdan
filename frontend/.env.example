# Copy to `.env` (local dev) and/or `.env.production` (production builds). Do not commit real secrets.

# Optional. Browser-facing portal URL for QR codes and shared links (no trailing slash).
# If missing OR unset in your shell: the app uses a built-in production fallback
# (`https://harit-infield.serenticaglobal.com`) outside the browser, and in the browser
# it uses the current tab origin (e.g. http://localhost:5173 in dev) — no .env required.
# VITE_BASE_URL=https://harit-infield.serenticaglobal.com

# Backend API base URL (see src/api.ts). Example:
# VITE_API_BASE_URL=https://your-api-host.example.com/
