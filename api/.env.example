# Copy to .env and fill in values. Do not commit .env.

# --- App ---
NODE_ENV=development
PORT=8000
# Optional. Primary browser origin for CORS (no trailing slash). If omitted, server.ts
# defaults to https://harit-infield.serenticaglobal.com — the API runs without this key set.
# FRONTEND_ORIGIN=https://harit-infield.serenticaglobal.com
# Optional comma-separated extra origins (preview deployments, etc.).
# FRONTEND_ORIGINS_EXTRA=https://branch-preview.vercel.app
# Set on Vercel serverless so the app exports the handler instead of calling listen()
# VERCEL=

# --- Database ---
MONGO_URI=mongodb://localhost:27017/verdan

# --- Auth (required for API) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
#
# Token lifetimes (jsonwebtoken "expiresIn" format). Defaults: 12h access, 30d refresh.
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d
# Refresh cookie max age (milliseconds). Default: 30 days.
JWT_REFRESH_COOKIE_MAX_AGE_MS=2592000000

# --- Signup / "Request access" — admin inbox (uses SMTP below) ---
# Preferred recipient. If empty, falls back to SMTP_FROM_EMAIL then SMTP_USER (must contain @).
# Use plain address or quoted — both are fine, e.g. admin@company.com or "admin@company.com"
# Comma/semicolon-separated for multiple addresses. Emails listed here also receive in-app
# notifications (access requests + team adds on all sites) if matching User accounts exist with role admin.
SIGNUP_NOTIFY_TO=

# Optional MongoDB site _id for the "Approve Request" link in access-request admin emails.
# If unset and exactly one site exists in the database, that site is used automatically.
# ACCESS_REQUEST_APPROVE_SITE_ID=

# --- Email: Resend (optional; not used for signup / request access — SMTP only for that flow) ---
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Welcome emails (new team members) ---
# Login link shown in the welcome email (optional; defaults to production portal URL)
# HARIT_PORTAL_URL=https://your-portal.example.com
# Alternative name also supported:
# FRONTEND_ORIGIN=https://your-portal.example.com

# --- Email: SMTP (admin notifications + public "Request access" form) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address for SMTP (optional; defaults to SMTP_USER — some servers require a verified from)
# SMTP_FROM_EMAIL=
# Display name in From header (optional; defaults to HARIT)
# SMTP_FROM_NAME=

# --- Optional: test-mail.js ---
# MAIL_TEST_TO=user@example.com   # recipient override (also accepts TEST_MAIL_TO)

# --- Scripts: seed ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# --- Object storage (S3) ---
# Used by tree/site media (may use presigned GET) and by /api/images (public-read objects + public URL in DB).
# For <img> in the portal, add a bucket CORS rule allowing GET from your portal origins.
# If the bucket has "Block all public access" on, either allow ACLs for public-read objects or use a bucket policy for public GetObject.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: base URL for objects (CDN). If empty, URLs are https://BUCKET.s3.REGION.amazonaws.com/KEY
# S3_PUBLIC_BASE_URL=
# Presigned URL lifetime for browser media (seconds, max 604800 = 7 days). Default 86400 (24h).
# S3_SIGNED_URL_EXPIRES_SECONDS=
# Local temp directory for queued image uploads (default: /tmp/uploads on this machine)
# LOCAL_IMAGE_UPLOAD_DIR=
